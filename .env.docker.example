AMLGUARD_ENVIRONMENT=development
AMLGUARD_REPOSITORY_BACKEND=postgres
AMLGUARD_DATABASE_URL=postgresql+asyncpg://amlguard:amlguard@postgres:5432/amlguard
AMLGUARD_DATABASE_DSN=postgresql://amlguard:amlguard@postgres:5432/amlguard?options=-csearch_path%3Dlanggraph
POSTGRES_HOST_PORT=55432
AMLGUARD_KEYCLOAK_ISSUER=http://localhost:8081/realms/amlguard
AMLGUARD_KEYCLOAK_INTERNAL_URL=http://keycloak:8080/realms/amlguard
AMLGUARD_KEYCLOAK_AUDIENCE=amlguard-api
AMLGUARD_DEV_AUTH_BYPASS=false
AMLGUARD_EDEN_AI_API_KEY=
AMLGUARD_EDEN_MODEL_ID=
OPENAI_API_KEY=
AMLGUARD_OTEL_ENDPOINT=http://otel-collector:4318
AMLGUARD_OTEL_ENABLED=true
AMLGUARD_ARTIFACT_ROOT=.artifacts
AMLGUARD_ARTIFACT_KEY_FILE=/run/secrets/artifact_key
AMLGUARD_RAW_RESEARCH_CAPTURE=true
AMLGUARD_POLICY_CORPUS_ROOT=regulatory_corpus
AMLGUARD_POLICY_JURISDICTION=FR
AMLGUARD_POLICY_RESULT_LIMIT=20
AMLGUARD_LLM_KILL_SWITCH=false
AMLGUARD_EXPERIMENT_KILL_SWITCH=false
