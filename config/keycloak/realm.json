{
  "realm": "amlguard",
  "enabled": true,
  "displayName": "AMLGuard-EU Research",
  "roles": {
    "realm": [
      {"name": "analyst"},
      {"name": "reviewer"},
      {"name": "researcher"},
      {"name": "administrator"}
    ]
  },
  "clients": [
    {
      "clientId": "amlguard-api",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "amlguard-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {"included.client.audience": "amlguard-api", "access.token.claim": "true"}
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "amlguard-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "amlguard-web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:8000/auth/callback",
        "http://127.0.0.1:8000/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:8000",
        "http://127.0.0.1:8000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8000/*##http://127.0.0.1:8000/*"
      },
      "protocolMappers": [
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "amlguard-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "analyst",
      "enabled": true,
      "firstName": "Local",
      "lastName": "Analyst",
      "email": "analyst@amlguard.local",
      "emailVerified": true,
      "attributes": {"tenant_id": ["amlguard-development"]},
      "credentials": [{"type": "password", "value": "analyst-dev", "temporary": false}],
      "realmRoles": ["analyst"]
    },
    {
      "username": "reviewer",
      "enabled": true,
      "firstName": "Local",
      "lastName": "Reviewer",
      "email": "reviewer@amlguard.local",
      "emailVerified": true,
      "attributes": {"tenant_id": ["amlguard-development"]},
      "credentials": [{"type": "password", "value": "reviewer-dev", "temporary": false}],
      "realmRoles": ["analyst", "reviewer"]
    },
    {
      "username": "researcher",
      "enabled": true,
      "firstName": "Local",
      "lastName": "Researcher",
      "email": "researcher@amlguard.local",
      "emailVerified": true,
      "attributes": {"tenant_id": ["amlguard-development"]},
      "credentials": [{"type": "password", "value": "researcher-dev", "temporary": false}],
      "realmRoles": ["researcher"]
    },
    {
      "username": "administrator",
      "enabled": true,
      "firstName": "Local",
      "lastName": "Administrator",
      "email": "administrator@amlguard.local",
      "emailVerified": true,
      "attributes": {"tenant_id": ["amlguard-development"]},
      "credentials": [{"type": "password", "value": "administrator-dev", "temporary": false}],
      "realmRoles": ["administrator"]
    }
  ]
}
